<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark theme: lighter greens so text stays legible on a dark surface. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_light</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/green_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/green_surface</item>
        <item name="colorSecondary">@color/status_expiring</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorError">@color/status_expired</item>
        <item name="android:colorBackground">@color/surface_dark</item>
    </style>

</resources>
